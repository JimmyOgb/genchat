# GenChat Environment Configuration
# Copy this file to .env.local for local development

# Groq Conversational AI (Required for Chat)
# Model: openai/gpt-oss-120b
GROQ_API_KEY=

# Supabase Auth & Persistence (Required for cloud persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GenLayer StudioNet Configuration
# Chain ID 61999 for StudioNet
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer StudioNet
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://studio.genlayer.com
# REQUIRED. There is no built-in default: the app fails with a clear error if this is missing,
# malformed, or a deprecated deployment. Production (e.g. Vercel) MUST set this explicitly to the
# current evidence-bound deployment. This single public variable is used by BOTH the frontend and
# the API routes, so they always target the same contract. It is an address, not a secret.
NEXT_PUBLIC_GENCHAT_CONTRACT_ADDRESS=0x4282234BF42F8e73De096E2f3C22A31F3b80e0f5

# Server-side GenLayer RPC (no private keys are used or required)
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
# NOTE: Do not set a separate GENCHAT_CONTRACT_ADDRESS. If present it must equal the public value above.

# Optional Web Search Provider for Research Mode (Serper or Tavily)
# If neither is set, GenChat will honestly notify that live web search is unconfigured.
SERPER_API_KEY=
TAVILY_API_KEY=
